<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="SnakeLauncherWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ========== 基础主题画刷（全局） ========== -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#666666" />
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="MenuForegroundBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#300078D4" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#0078D4" Opacity="0.8" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="GroupBoxHeaderBackgroundBrush" Color="#F0F0F0" />

        <!-- ========== ★ 新增：强调色的 hover / pressed / foreground（默认值，运行时会动态覆盖） ========== -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#008AF3" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#0060A9" />
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

        <!-- ========== 按钮中性色资源（浅色默认值） ========== -->
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="ButtonNeutralHoverBrush" Color="#20000000" />

        <!-- ========== SplashWindow 玻璃资源（默认浅色） ========== -->
        <Color x:Key="SplashShadowColor">#1A2A44</Color>

        <LinearGradientBrush x:Key="SplashGlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5FFFFFF" Offset="0"/>
            <GradientStop Color="#E0FFFFFF" Offset="0.55"/>
            <GradientStop Color="#CCFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SplashGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#30FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SplashBlob1Brush" Color="#5577C4FF"/>
        <SolidColorBrush x:Key="SplashBlob2Brush" Color="#55FFA8C4"/>
        <SolidColorBrush x:Key="SplashTrackBrush" Color="#33FFFFFF"/>
    </Application.Resources>
</Application>